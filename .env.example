# Backend - OpenRouter API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Backend - Firebase Admin SDK (path to service account JSON)
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json

# Frontend - Firebase Web Config (VITE_ prefix required for Vite)
# Get these from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=pyronic-apps
VITE_FIREBASE_APP_ID=1:427543310857:web:702ae82ac6b7604e537ed8
VITE_FIREBASE_STORAGE_BUCKET=pyronic-apps.firebasestorage.app
VITE_FIREBASE_AUTH_DOMAIN=pyronic-apps.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=427543310857
